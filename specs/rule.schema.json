{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentready-lab:schema:rule-registry:v0",
  "title": "AgentReady Lab rules registry v0",
  "description": "Schema for the frozen external compatibility snapshot: what IsItAgentReady published on snapshot.captured_at. ADR-0008 section 2 moved registry_version, ruleset_id, ruleset_version and sources out of this file; the source ledger is specs/sources.schema.json and the executable ruleset is specs/ruleset.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "modes",
    "status_model",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "compat", "interop"],
      "properties": {
        "spec": {
          "$ref": "#/$defs/mode"
        },
        "compat": {
          "$ref": "#/$defs/mode"
        },
        "interop": {
          "$ref": "#/$defs/mode"
        }
      }
    },
    "status_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "warning",
        "not-applicable",
        "unable-to-check",
        "unsupported-runtime"
      ],
      "properties": {
        "pass": {
          "type": "string",
          "minLength": 1
        },
        "fail": {
          "type": "string",
          "minLength": 1
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "not-applicable": {
          "type": "string",
          "minLength": 1
        },
        "unable-to-check": {
          "type": "string",
          "minLength": 1
        },
        "unsupported-runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "captured_at",
        "compatibility_source",
        "published_check_count",
        "disclaimer"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date"
        },
        "compatibility_source": {
          "type": "string",
          "format": "uri"
        },
        "published_check_count": {
          "const": 22
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "surface_drift": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "description"],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "id",
        "rule_id",
        "rule_version",
        "title",
        "category",
        "maturity",
        "profiles",
        "runtime",
        "applicability",
        "source_refs",
        "compat",
        "spec",
        "interop"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "rule_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "discoverability",
            "content-accessibility",
            "bot-access-control",
            "discovery",
            "commerce"
          ]
        },
        "maturity": {
          "description": "Maturity of the pinned source set, not implementation status.",
          "enum": [
            "stable",
            "mixed",
            "draft",
            "experimental",
            "convention",
            "beta"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "content",
              "api",
              "agent-service",
              "commerce",
              "full"
            ]
          },
          "uniqueItems": true
        },
        "runtime": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["http", "dns", "browser"]
          },
          "uniqueItems": true
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "compat": {
          "$ref": "#/$defs/compat"
        },
        "spec": {
          "$ref": "#/$defs/spec"
        },
        "interop": {
          "$ref": "#/$defs/interop"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "when"],
      "properties": {
        "default": {
          "enum": ["applicable", "informational", "opt-in", "commerce-opt-in"]
        },
        "when": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_behavior", "pass_heuristic", "status_semantics"],
      "properties": {
        "score_behavior": {
          "enum": ["scored", "informational-unscored", "commerce-conditional"]
        },
        "pass_heuristic": {
          "type": "string",
          "minLength": 1
        },
        "status_semantics": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_scope", "requirements", "deltas"],
      "properties": {
        "claim_scope": {
          "enum": [
            "normative-conformance",
            "profile-conformance",
            "syntax-validation",
            "detection-only",
            "no-current-conformance-claim"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "deltas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strength", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "strength": {
          "enum": ["normative", "recommended", "advisory"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "safe_actions", "caveats"],
      "properties": {
        "disposition": {
          "enum": [
            "safe-read-only",
            "browser-required",
            "known-endpoint-required",
            "not-in-mvp"
          ]
        },
        "safe_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
