{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "test/**/*.ts",
    "scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**"]
}
